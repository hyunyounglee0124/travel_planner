# ------------------------------------------------------------
# 이 파일을 복사해서 .env 를 만든 뒤 실제 값을 채우세요.
#   macOS/Linux : cp .env.example .env
#   Windows     : copy .env.example .env
# .env 는 .gitignore 에 등록되어 있어 Git 에 올라가지 않습니다.
# 값에는 따옴표/공백을 넣지 마세요.  예) OPENAI_API_KEY=sk-proj-abc...
# ------------------------------------------------------------

# 사용할 제공자 선택 (openai | gemini), (kakao | naver)
LLM_PROVIDER=openai
PLACE_PROVIDER=kakao

# --- LLM: 둘 중 사용하는 것만 채우면 됩니다 ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- 지도/장소 검색: 둘 중 사용하는 것만 채우면 됩니다 ---
KAKAO_REST_API_KEY=

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
